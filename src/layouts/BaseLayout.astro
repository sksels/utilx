---
// Shared page shell for every public + tool page on the site.
//
// theme.js MUST stay the literal first thing inside <head> -- tests/theme.test.js asserts
// this via a regex against the built HTML. Do not reorder anything above it.
//
// Two header variants exist in the original hand-written HTML: the full site header (brand +
// trust badge + nav + theme toggle) used everywhere public-facing, and a minimal brand-only
// header used only on the token-gated admin dashboard (which also skips theme.js, AdSense,
// analytics, and the footer entirely in the original markup). The `header`/`includeThemeJs`/
// `showFooter` props reproduce that split faithfully rather than forcing one shape everywhere.
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
  /** e.g. '/', '/about.html', '/tools/regex-tester.html'. Presence triggers canonical + OG + Twitter meta. */
  canonicalPath?: string;
  /** Adds manifest link, theme-color, apple-mobile-web-app-* tags, pwa-lib.js, sw-register.js. */
  pwa?: boolean;
  /** Raw JSON string for an application/ld+json block (tool pages only). */
  jsonLd?: string;
  /** Tool pages only -- e.g. 'json-formatter', 'color-converter'. Sets data-tool-id on <html>,
      which style.css's :root.popup-mode[data-tool-id="..."] rules use to border the popup
      window in that tool's own icon color (CR#8 backlog #57). Must exactly match the
      corresponding chip-* and --tool-accent-* suffix in style.css. */
  toolId?: string;
  /** Loads theme.js as the first head element. Default true; admin dashboard sets false. */
  includeThemeJs?: boolean;
  /** Loads the AdSense loader script + analytics.js. Default true; admin dashboard sets false. */
  includeAdsAndAnalytics?: boolean;
  /** Homepage only. */
  includePopupNav?: boolean;
  /** Homepage only. */
  includeTileOrder?: boolean;
  /** Homepage only. CR#8 backlog #32: clipboard-based tool suggestion toast. */
  includeClipboardSuggest?: boolean;
  /** CR#8 #35: native command palette (Cmd/Ctrl+K). Defaults to true whenever the full header
      is shown -- it's meant to be global nav, available from every page -- and false for the
      admin dashboard (header: 'minimal'), matching how that page already opts out of
      theme.js/ads/analytics/footer. Pass explicitly only to override that default. */
  includeCommandPalette?: boolean;
  /** 'full' = brand + trust badge + nav + theme toggle. 'minimal' = brand link only (admin). */
  header?: 'full' | 'minimal';
  showFooter?: boolean;
  /** Admin dashboard: noindex, nofollow. */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  pwa = false,
  jsonLd,
  toolId,
  includeThemeJs = true,
  includeAdsAndAnalytics = true,
  includePopupNav = false,
  includeTileOrder = false,
  includeClipboardSuggest = false,
  header = 'full',
  showFooter = true,
  noindex = false,
} = Astro.props;
const includeCommandPalette = Astro.props.includeCommandPalette ?? (header === 'full');

const siteUrl = 'https://utilx.tools';
const canonicalUrl = canonicalPath ? siteUrl + canonicalPath : null;
const ogImage = siteUrl + '/og-image.png';
const isHome = canonicalPath === '/';
---

<!DOCTYPE html>
<html lang="en" data-tool-id={toolId}>
<head>
{includeThemeJs && <script is:inline src="/theme.js"></script>}
<script is:inline>
// A tool opened via the homepage's "open in popup window" feature (popup-nav.js) loads this
// exact same page/CSS in a separate window -- previously indistinguishable from the main
// site at a glance, which read as a bug rather than "yes, this really is a separate window".
// window.opener is only ever set when a page was opened via window.open() from another page
// (never on a normal navigation or a directly-typed URL), so this is a reliable, zero-cost
// signal with no extra script file needed. See the .popup-mode background overrides in
// style.css.
if (window.opener) document.documentElement.classList.add('popup-mode');
</script>
{header === 'full' && (
<script is:inline>
// Popup compaction system (backlog #61, #77, CR#10) -- part 2 of 2, see style.css's
// "POPUP COMPACTION SYSTEM" comment block for the full picture. A table.ref-table can be
// static markup (regex-tester's flag reference, cron-builder's schedule examples) or built
// at runtime by a tool's own script (color-converter's contrast-ratio result, appended to
// #contrastResult on input) -- either way, once it exists in the DOM it gets wrapped here in
// a .ref-table-scroll container, which style.css caps to a fixed max-height with its own
// internal scrollbar. That keeps a long reference/example table from ever forcing the whole
// popup page to scroll, without deleting a single row of it, and without needing any
// per-tool code: this runs for every tool page equally, keyed only on the table.ref-table
// class every such table already uses. Wrapping (not `display:block` on the table itself)
// is deliberate -- collapsing a table to a block box breaks its column-width layout once
// rows are no longer laid out together, visibly misaligning columns row to row.
// DOMContentLoaded (not `load`) so this has already run by the time the resize/center script
// below measures scrollHeight on `load`.
if (window.opener) {
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('table.ref-table').forEach(function (table) {
      if (table.closest('.ref-table-scroll')) return;
      var wrapper = document.createElement('div');
      wrapper.className = 'ref-table-scroll';
      table.parentNode.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
    // Any <details open class="popup-collapsible"> is a section a tool page has marked as
    // genuinely secondary (JWT Decoder inside Base64 Tool, "sample from an image" inside
    // Color Converter, the v4/v7/v1 explainer inside Password Generator, and whatever the
    // next tool needs this for) -- expanded by default on the full page (the `open` attribute
    // in markup), collapsed by default only inside a popup, where it's the difference between
    // fitting on one screen and needing a scrollbar. Still fully present and functional either
    // way, one click away. This is the one part of the compaction system that is a per-tool
    // judgment call rather than a blanket selector rule -- see style.css's "POPUP COMPACTION
    // SYSTEM" comment for when to reach for it.
    document.querySelectorAll('details.popup-collapsible').forEach(function (d) {
      d.open = false;
    });
  });
}
</script>
)}
{header === 'full' && (
<script is:inline>
// Backlog #61 ("compact popup windows -- eliminate excess whitespace, center on screen, show
// all content without scrolling"), raised more than once and never actually landed. Earlier
// attempts (#52, and popup-nav.js's own DEFAULT_WIDTH/HEIGHT constants) all guessed at one
// shared width/height for every tool -- which can only ever be exactly right for one tool and
// too tall/too short/too narrow for the rest. This instead measures each popup's own real
// rendered content, once it's actually settled, and resizes+recenters the real window to fit
// it -- so it's correct per tool, per viewport, and stays correct if a tool's content ever
// changes height again, with no constant to re-tune next time. Only runs for a window opened
// via window.open() (window.opener set -- the same signal already used for popup-mode above);
// window.resizeTo/moveTo are script-callable only on windows the script itself opened, which is
// exactly this case, so this can't affect a normal tab a visitor opened themselves.
if (window.opener) {
  window.addEventListener('load', function () {
    // One frame + a short delay so layout has fully settled (fonts/images swapping in,
    // popup-mode's tighter CSS having applied) before measuring -- measuring too early would
    // capture a not-yet-final content height.
    setTimeout(function () {
      try {
        var doc = document.documentElement;
        var body = document.body;
        var contentWidth = Math.max(doc.scrollWidth, body.scrollWidth);
        var contentHeight = Math.max(doc.scrollHeight, body.scrollHeight);
        // scrollWidth/scrollHeight measure the inner document; resizeTo sets the OUTER window
        // size (includes the browser's own title bar / window borders). Adding the delta
        // already present between outerWidth/innerWidth (and the height equivalent) keeps the
        // resize accurate instead of clipping content by that same chrome allowance.
        var chromeWidth = Math.max(0, window.outerWidth - window.innerWidth);
        var chromeHeight = Math.max(0, window.outerHeight - window.innerHeight);
        var targetWidth = Math.min(screen.availWidth, contentWidth + chromeWidth);
        var targetHeight = Math.min(screen.availHeight, contentHeight + chromeHeight);
        window.resizeTo(targetWidth, targetHeight);
        var left = Math.max(0, Math.round((screen.width - targetWidth) / 2));
        var top = Math.max(0, Math.round((screen.height - targetHeight) / 2));
        window.moveTo(left, top);
      } catch (e) {
        // Some browsers/extensions block script resize/move of a window after it's been
        // focused/interacted with -- fails silently. popup-nav.js's original fixed size (now
        // tighter, see style.css's popup-mode padding rules) plus scrollbars=yes remains the
        // safety net either way, so this never leaves content inaccessible, only unresized.
      }
    }, 60);
  });
}
</script>
)}
{includeAdsAndAnalytics && (
  <script is:inline>
  // Real regression found via Lighthouse CI (Aug 24 2026): this ~260KB Google AdSense loader
  // (Auto Ads script + its sodar/config calls) was previously loaded eagerly via a plain
  // <script async> tag -- `async` only means "don't block HTML parsing," not "don't compete for
  // bandwidth/CPU right now." Under Lighthouse's Slow-4G + CPU-throttled emulation this was 77%
  // of base64-tool.html's total network weight and starved that page's own paint of bandwidth
  // and main-thread time, even though the tag is byte-for-byte identical on every page (that
  // page's LCP candidate is simply the one with the least margin to absorb the contention).
  // No <ins class="adsbygoogle"> ad units exist yet -- see README's "before applying for
  // AdSense" checklist -- so nothing currently depends on this having loaded by any particular
  // moment. Deferring to page idle (same pattern as the command palette's Fuse.js load, see
  // CommandPalette.astro) costs nothing once Auto Ads is actually live, while taking a third of
  // a megabyte of third-party JS fully out of the critical rendering path for every visitor.
  var idleLoadAds = window.requestIdleCallback || function (fn) { setTimeout(fn, 1500); };
  idleLoadAds(function () {
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2667223941564745';
    s.crossOrigin = 'anonymous';
    document.head.appendChild(s);
  });
  </script>
)}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{isHome && <meta name="msvalidate.01" content="84DF4059257E3782D888BDA0B1069A03" />}
{noindex && <meta name="robots" content="noindex, nofollow">}
<title>{title}</title>
{description && <meta name="description" content={description}>}
{canonicalUrl && <link rel="canonical" href={canonicalUrl}>}
{canonicalUrl && (
  <>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="UtilX">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
  </>
)}
{includeAdsAndAnalytics && <script is:inline defer src="/analytics.js"></script>}
{/* CR#8 #35: selecting a palette result now opens the tool in the same popup window the
    homepage tiles use (window.openToolPopup, defined here) -- so this needs to load on every
    page the palette is on, not just the homepage. One shared condition (instead of a second
    near-identical script tag) avoids loading popup-nav.js twice on index.astro, which sets
    both includePopupNav and includeCommandPalette. */}
{(includePopupNav || includeCommandPalette) && <script is:inline src="/popup-nav.js"></script>}
<link rel="stylesheet" href="/style.css">
{pwa && (
  <>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon-192.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <meta name="theme-color" content="#0f1117">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="UtilX">
    <script is:inline defer src="/pwa-lib.js"></script>
    <script is:inline defer src="/sw-register.js"></script>
  </>
)}
{includeTileOrder && <script is:inline src="/tile-order.js"></script>}
{includeClipboardSuggest && (
  <>
    <script is:inline src="/tools/lib/cron.js"></script>
    <script is:inline src="/tools/lib/color.js"></script>
    <script is:inline src="/tools/lib/base64.js"></script>
    <script is:inline src="/tools/lib/clipboard-detect.js"></script>
    <script is:inline defer src="/clipboard-suggest.js"></script>
  </>
)}
<slot name="head-extra" />
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
</head>
<body>

{header === 'full' ? (
  <header class="site">
    <div class="wrap">
      <div class="brand-group">
        <a class="brand" href="/index.html">Util<span>X</span></a>
        <span class="trust-badge" title="No cookies, no third-party trackers — every tool runs entirely in your browser">0 cookies &middot; 0 trackers</span>
      </div>
      <nav class="site-nav">
        <a href="/index.html">Tools</a>
        <a href="/guides/what-is-json.html">Guides</a>
        <a href="/about.html">About</a>
        <a href="/contact.html">Contact</a>
        {includeCommandPalette && (
          <button type="button" id="utilx-palette-trigger" class="palette-trigger" aria-label="Open command palette" title="Search tools and guides (Cmd/Ctrl+K)">
            <svg class="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6"/><line x1="20" y1="20" x2="14.5" y2="14.5"/></svg>
            <kbd class="palette-trigger-kbd">Ctrl/&#8984;K</kbd>
          </button>
        )}
        <button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle light or dark theme" title="Your light/dark choice is saved only in this browser (localStorage) — never sent to us or anyone else">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
        </button>
      </nav>
    </div>
  </header>
) : (
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/index.html">Util<span>X</span></a>
    </div>
  </header>
)}

{includeCommandPalette && <CommandPalette />}

<slot />

{showFooter && (
  <footer class="site">
    <div class="wrap">
      <span>&copy; 2026 UtilX</span>
      <span><a href="/about.html">About</a> &middot; <a href="/privacy.html">Privacy</a> &middot; <a href="/contact.html">Contact</a></span>
    </div>
  </footer>
)}

<slot name="body-end" />

</body>
</html>
