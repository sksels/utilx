---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OutputToolbar from '../../components/OutputToolbar.astro';
import LocalBadge from '../../components/LocalBadge.astro';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "JSON Formatter, Validator & Diff Checker",
  "url": "https://utilx.tools/tools/json-formatter.html",
  "description": "Free online JSON formatter, validator, and diff checker. Pinpoints exact syntax error locations, beautifies or minifies JSON, and compares two JSON blobs to show exactly what changed — all in your browser.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any (runs in browser)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "isAccessibleForFree": true,
  "publisher": {
    "@type": "Organization",
    "name": "UtilX",
    "url": "https://utilx.tools/"
  }
}, null, 2);
---
<BaseLayout
  title="JSON Formatter, Validator & Diff Checker | UtilX"
  description="Free online JSON formatter, validator, and diff checker. Pinpoints exact syntax error locations, beautifies or minifies JSON, and compares two JSON blobs to show exactly what changed — all in your browser."
  canonicalPath="/tools/json-formatter.html"
  pwa={true}
  jsonLd={jsonLd}
>
<Fragment slot="head-extra">
<script is:inline src="lib/json-tools.js"></script>
<script is:inline src="lib/shortcuts.js"></script>
<script is:inline src="lib/url-state.js"></script>
<script is:inline src="lib/html-escape.js"></script>
<script is:inline src="/output-toolbar.js"></script>
<script is:inline src="/local-state.js"></script>
</Fragment>

<main>
  <div class="wrap">
    <div class="breadcrumb"><a href="/index.html">Tools</a> / JSON Formatter</div>
    <h1>JSON Formatter &amp; Validator</h1>
    <p class="lede">Paste JSON below to beautify, minify, or validate it. Nothing is uploaded — everything runs in your browser.</p>
    <div><LocalBadge /></div>

    <div class="card">
      <div class="field-header">
        <label for="input">Input JSON</label>
        <select id="inputRecent" class="recent-select" title="Load a recent input" disabled></select>
      </div>
      <div class="input-box">
        <textarea id="input" rows="10" placeholder='{"name":"Ada","active":true,"tags":["math","cs"]}'></textarea>

        <div class="input-secondary">
          <label for="indent">Indent size</label>
          <select id="indent">
            <option value="2">2 spaces</option>
            <option value="4">4 spaces</option>
            <option value="tab">Tab</option>
          </select>
        </div>

        <div class="input-actions">
          <button onclick="formatJson()">Format / Beautify</button>
          <button class="secondary" onclick="minifyJson()">Minify</button>
          <button class="secondary" onclick="copyShareLink()">Copy shareable link</button>
          <button class="secondary" onclick="clearAll()">Clear</button>
        </div>
      </div>
      <p style="color:var(--text-dim); font-size:0.8rem; margin:6px 0 0;">Tip: press Ctrl+Enter (Cmd+Enter on Mac) to format.</p>

      <div id="msg"></div>

      <div class="output-box">
        <label for="output">Output</label>
        <div class="output-target">
          <textarea id="output" rows="12" readonly></textarea>
          <OutputToolbar targetId="output" download={true} downloadFilename="formatted.json" />
        </div>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Compare two JSON blobs</h2>
      <p style="color:var(--text-dim); margin-top:-8px;">Paste two versions of a JSON document to see exactly what changed between them.</p>
      <div class="two-col">
        <div>
          <label for="diffA">JSON A (before)</label>
          <textarea id="diffA" rows="8" placeholder='{"name":"Ada","active":true}'></textarea>
        </div>
        <div>
          <label for="diffB">JSON B (after)</label>
          <textarea id="diffB" rows="8" placeholder='{"name":"Ada","active":false,"role":"admin"}'></textarea>
        </div>
      </div>
      <div>
        <button onclick="compareJson()">Compare</button>
      </div>
      <div id="diffMsg"></div>
      <div class="output-box" id="diffResultBox" style="display:none;">
        <table class="ref-table" id="diffTable">
          <tr><th>Path</th><th>Change</th><th>Before</th><th>After</th></tr>
        </table>
      </div>
    </div>


    <h2>How this works</h2>
    <p>This tool parses your JSON with the browser's built-in <code>JSON.parse</code> and re-serializes it with <code>JSON.stringify</code>. If your JSON is invalid, it tells you exactly where the parser stopped, so you can fix syntax errors like trailing commas, missing quotes, or unescaped characters quickly. See the <a href="/guides/what-is-json.html">JSON basics guide</a> for common mistakes.</p>
    <p>Related tool: decoding a JWT? Its payload is Base64-encoded JSON — decode it with the <a href="/tools/base64-tool.html">Base64 Encoder / Decoder</a>, then format the result here.</p>
  </div>
</main>

<script is:inline>
function getIndent() {
  const v = document.getElementById('indent').value;
  return v === 'tab' ? '\t' : Number(v);
}

// Security note: JS engine error messages (JSON.parse SyntaxError, RegExp errors, etc.) can
// embed a snippet of the raw, attacker-controllable input verbatim -- this page auto-runs on
// load from a URL-encoded state (see restoreFromUrl below), so an unescaped innerHTML
// assignment here would be a reflected-XSS vector triggerable by just clicking a crafted
// link. Always escape before inserting into innerHTML, never trust "just an error message."
const escapeHtml = HtmlEscapeLib.escapeHtml;

function showError(e) {
  const msg = document.getElementById('msg');
  msg.innerHTML = '<div class="error-msg">Invalid JSON: ' + escapeHtml(e.message) + '</div>';
}

function showSuccess(text) {
  const msg = document.getElementById('msg');
  msg.innerHTML = '<div class="success-msg">' + text + '</div>';
}

// Persistent local state (CR#6): this tool's recent-input history and indent preference,
// all local-only (see public/local-state.js -- same model as theme/tile-order persistence).
const RECENT_KEY = 'utilx-json-formatter-recent';
const INDENT_KEY = 'utilx-json-formatter-indent';

function formatJson() {
  const input = document.getElementById('input').value;
  try {
    const parsed = JSON.parse(input);
    document.getElementById('output').value = JSON.stringify(parsed, null, getIndent());
    showSuccess('Valid JSON — formatted below.');
    LocalStateLib.recordRecent(RECENT_KEY, input);
    refreshRecentSelect();
  } catch (e) {
    showError(e);
    document.getElementById('output').value = '';
  }
}

function minifyJson() {
  const input = document.getElementById('input').value;
  try {
    const parsed = JSON.parse(input);
    document.getElementById('output').value = JSON.stringify(parsed);
    showSuccess('Valid JSON — minified below.');
    LocalStateLib.recordRecent(RECENT_KEY, input);
    refreshRecentSelect();
  } catch (e) {
    showError(e);
    document.getElementById('output').value = '';
  }
}

function refreshRecentSelect() {
  LocalStateLib.populateRecentSelect(document.getElementById('inputRecent'), RECENT_KEY, 'Recent inputs...');
}

function clearAll() {
  document.getElementById('input').value = '';
  document.getElementById('output').value = '';
  document.getElementById('msg').innerHTML = '';
}

function copyShareLink() {
  const url = UrlStateLib.buildShareUrl(location.origin, location.pathname, {
    input: document.getElementById('input').value,
    indent: document.getElementById('indent').value,
  });
  const temp = document.createElement('input');
  temp.value = url;
  document.body.appendChild(temp);
  temp.select();
  document.execCommand('copy');
  document.body.removeChild(temp);
  showSuccess('Shareable link copied to clipboard.');
}

document.addEventListener('keydown', (e) => {
  if (ShortcutsLib.isRunShortcut(e)) {
    e.preventDefault();
    formatJson();
  }
});

OutputToolbarLib.init();

// Persist the indent-size choice across visits (URL-shared state, when present, still wins
// -- see restoreFromUrl below, which runs after this and overrides it).
(function restoreIndentPref() {
  const saved = LocalStateLib.loadPref(INDENT_KEY);
  if (saved) document.getElementById('indent').value = saved;
})();
document.getElementById('indent').addEventListener('change', (e) => {
  LocalStateLib.savePref(INDENT_KEY, e.target.value);
});

refreshRecentSelect();
document.getElementById('inputRecent').addEventListener('change', (e) => {
  if (!e.target.value) return;
  document.getElementById('input').value = e.target.value;
  formatJson();
  e.target.value = '';
});

(function restoreFromUrl() {
  const state = UrlStateLib.decodeState(location.search);
  if (!state) return;
  if (typeof state.input === 'string') document.getElementById('input').value = state.input;
  if (typeof state.indent === 'string') document.getElementById('indent').value = state.indent;
  if (state.input) formatJson();
})();

const shortVal = JsonToolsLib.shortVal;
const deepDiff = JsonToolsLib.deepDiff;

function compareJson() {
  const msg = document.getElementById('diffMsg');
  const box = document.getElementById('diffResultBox');
  const table = document.getElementById('diffTable');
  msg.innerHTML = '';

  let a, b;
  try {
    a = JSON.parse(document.getElementById('diffA').value);
  } catch (e) {
    msg.innerHTML = '<div class="error-msg">JSON A is invalid: ' + escapeHtml(e.message) + '</div>';
    box.style.display = 'none';
    return;
  }
  try {
    b = JSON.parse(document.getElementById('diffB').value);
  } catch (e) {
    msg.innerHTML = '<div class="error-msg">JSON B is invalid: ' + escapeHtml(e.message) + '</div>';
    box.style.display = 'none';
    return;
  }

  let diffs;
  try {
    diffs = deepDiff(a, b, '', []);
  } catch (e) {
    // Tech debt fix: deepDiff used to recurse once per nesting level and could hit the call-
    // stack limit on very deeply nested (but perfectly valid) JSON -- confirmed around ~5,000
    // levels deep, versus JSON.parse itself, which handles 100,000+ levels fine. It's now
    // rewritten (tools/lib/json-tools.js) to use an explicit stack instead of recursion, so
    // this should no longer be reachable for depth reasons -- kept as a defensive fallback in
    // case of some other unexpected failure, so Compare never silently does nothing.
    msg.innerHTML = '<div class="error-msg">Could not compare these JSON documents (' + escapeHtml(e.message) + ').</div>';
    box.style.display = 'none';
    return;
  }
  table.innerHTML = '<tr><th>Path</th><th>Change</th><th>Before</th><th>After</th></tr>';

  if (diffs.length === 0) {
    msg.innerHTML = '<div class="success-msg">No differences — both are equivalent.</div>';
    box.style.display = 'block';
    return;
  }

  msg.innerHTML = '<div class="success-msg">' + diffs.length + ' difference' + (diffs.length === 1 ? '' : 's') + ' found.</div>';
  diffs.forEach(function (d) {
    const tr = document.createElement('tr');
    const color = d.type === 'added' ? '#4ade80' : d.type === 'removed' ? '#ff6b6b' : '#5b8cff';
    tr.innerHTML = '<td><code>' + d.path + '</code></td>' +
      '<td style="color:' + color + ';">' + d.type + '</td>' +
      '<td>' + shortVal(d.from) + '</td>' +
      '<td>' + shortVal(d.to) + '</td>';
    table.appendChild(tr);
  });
  box.style.display = 'block';
}
</script>
</BaseLayout>
