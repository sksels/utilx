---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OutputToolbar from '../../components/OutputToolbar.astro';
import LocalBadge from '../../components/LocalBadge.astro';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Regex Tester + Plain-English Pattern Explainer",
  "url": "https://utilx.tools/tools/regex-tester.html",
  "description": "Free online regex tester for JavaScript with a plain-English breakdown of what your pattern actually does. Try ready-made patterns for email and phone validation, or test your own with live match highlighting.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any (runs in browser)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "isAccessibleForFree": true,
  "publisher": {
    "@type": "Organization",
    "name": "UtilX",
    "url": "https://utilx.tools/"
  }
}, null, 2);
---
<BaseLayout
  title="Regex Tester + Plain-English Pattern Explainer | UtilX"
  description="Free online regex tester for JavaScript with a plain-English breakdown of what your pattern actually does. Try ready-made patterns for email and phone validation, or test your own with live match highlighting."
  canonicalPath="/tools/regex-tester.html"
  pwa={true}
  jsonLd={jsonLd}
>
<Fragment slot="head-extra">
<script is:inline src="lib/regex-explain.js"></script>
<script is:inline src="lib/shortcuts.js"></script>
<script is:inline src="lib/url-state.js"></script>
<script is:inline src="lib/html-escape.js"></script>
<script is:inline src="lib/regex-run.js"></script>
<script is:inline src="/output-toolbar.js"></script>
<script is:inline src="/local-state.js"></script>
</Fragment>

<main>
  <div class="wrap">
    <div class="breadcrumb"><a href="/index.html">Tools</a> / Regex Tester</div>
    <h1>Regex Tester</h1>
    <p class="lede">Test a regular expression against sample text and see matches highlighted live. Uses JavaScript's regex engine.</p>
    <div><LocalBadge /></div>

    <div class="card">
      <div class="field-header">
        <label for="pattern">Pattern</label>
        <select id="patternRecent" class="recent-select" title="Load a recent pattern" disabled></select>
      </div>
      <input type="text" id="pattern" placeholder="\b[A-Z][a-z]+\b">

      <label for="flags">Flags</label>
      <input type="text" id="flags" value="g" placeholder="e.g. gi (no spaces)">

      <label for="testtext">Test string</label>
      <div class="input-box">
        <div class="input-target">
          <textarea id="testtext" rows="8" placeholder="Paste sample text here to test your pattern against it."></textarea>
          <div class="input-toolbar">
            <button class="toolbar-btn primary" onclick="runRegex()" title="Test Regex">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v16l13-8Z"/></svg>
            </button>
            <button class="toolbar-btn" onclick="explainPattern()" title="Explain pattern">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 17v-.5"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 4"/></svg>
            </button>
            <button class="toolbar-btn" onclick="copyShareLink()" title="Copy shareable link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
            <button class="toolbar-btn" onclick="clearAll()" title="Clear">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>
        </div>
      </div>
      <p style="color:var(--text-dim); font-size:0.8rem; margin:6px 0 0;">Tip: press Ctrl+Enter (Cmd+Enter on Mac) to test.</p>

      <div id="msg"></div>

      <div class="output-box">
        <label>Highlighted matches</label>
        <div id="highlighted" class="card" style="white-space: pre-wrap; word-break: break-word; min-height: 60px;"></div>
      </div>

      <div class="output-box">
        <label>Match details</label>
        <div class="output-target">
          <textarea id="matches" rows="8" readonly></textarea>
          <OutputToolbar targetId="matches" download={true} downloadFilename="matches.txt" />
        </div>
      </div>

      <div class="output-box" id="explainBox" style="display:none;">
        <label>Plain-English breakdown</label>
        <div class="output-target">
          <pre id="explainOutput" style="white-space: pre-wrap; background:var(--code-bg); border:1px solid var(--border); border-radius:8px; padding:14px; font-size:0.85rem;"></pre>
          <OutputToolbar targetId="explainOutput" />
        </div>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Common patterns</h2>
      <p style="color:var(--text-dim); margin-top:-8px;">Click to load a ready-made pattern into the tester above.</p>
      <div>
        <button class="secondary" onclick="loadPattern('\\b[\\w.+-]+@[\\w-]+\\.[a-zA-Z]{2,}\\b', 'test@example.com\nnot-an-email\nfirst.last+tag@sub.example.co')">Email validation</button>
        <button class="secondary" onclick="loadPattern('\\+?1?[-.\\s]?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}', '(555) 123-4567\n555-123-4567\n+1 555.123.4567\nnot a number')">Phone number (US)</button>
        <button class="secondary" onclick="loadPattern('https?:\\/\\/[\\w.-]+\\.[a-zA-Z]{2,}(\\/\\S*)?', 'https://utilx.tools/tools\nhttp://example.com\nnot a url')">URL</button>
        <button class="secondary" onclick="loadPattern('^\\d{5}(-\\d{4})?$', '90210\n90210-1234\nabcde')">US ZIP code</button>
      </div>
    </div>


    <h2>Common flags</h2>
    <table class="ref-table">
      <tr><th>Flag</th><th>Meaning</th></tr>
      <tr><td><code>g</code></td><td>Global — find all matches, not just the first</td></tr>
      <tr><td><code>i</code></td><td>Case-insensitive</td></tr>
      <tr><td><code>m</code></td><td>Multiline — <code>^</code> and <code>$</code> match line boundaries</td></tr>
      <tr><td><code>s</code></td><td>Dot matches newline characters too</td></tr>
    </table>
    <p>Need a syntax refresher? See the <a href="/guides/regex-cheatsheet.html">regex cheat sheet</a>.</p>
    <p>Related tool: validating or extracting structured data with your pattern? Check the result with the <a href="/tools/json-formatter.html">JSON Formatter &amp; Validator</a>.</p>
  </div>
</main>

<script is:inline>
function loadPattern(pattern, sample) {
  document.getElementById('pattern').value = pattern;
  document.getElementById('testtext').value = sample;
  runRegex();
  explainPattern();
  document.getElementById('pattern').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function explainPattern() {
  const pattern = document.getElementById('pattern').value;
  const box = document.getElementById('explainBox');
  const out = document.getElementById('explainOutput');
  if (!pattern) {
    box.style.display = 'none';
    return;
  }
  try {
    new RegExp(pattern); // validate it compiles first
    const lines = RegexExplainLib.explainRegex(pattern);
    out.textContent = lines.length ? lines.join('\n') : 'Empty pattern.';
    box.style.display = 'block';
  } catch (e) {
    out.textContent = 'Could not parse: ' + e.message;
    box.style.display = 'block';
  }
}

const escapeHtml = HtmlEscapeLib.escapeHtml;

// Tech debt fix (ReDoS protection): a catastrophic-backtracking pattern (classic example:
// /(a+)+$/ against a long string with no trailing match) can make regex matching run for
// an effectively unbounded amount of time -- previously this ran directly on the main
// thread inside runRegex(), so a pattern like that would freeze the whole tab with no way
// to recover except closing it. The match loop now runs inside a Web Worker
// (lib/regex-worker.js); if it doesn't respond within REGEX_TIMEOUT_MS, the worker is
// forcibly terminated and the page shows a clear message instead of hanging. Falls back to
// running inline (old behavior, unprotected) only if Workers aren't available/constructible
// at all, so the tool still works in that rare case.
const REGEX_TIMEOUT_MS = 2000;
let regexWorker = null;
let regexRequestSeq = 0;
let regexWorkerTimeout = null;

function getRegexWorker() {
  if (!regexWorker) regexWorker = new Worker('lib/regex-worker.js');
  return regexWorker;
}

function applyRegexResult(data) {
  const msg = document.getElementById('msg');
  const highlighted = document.getElementById('highlighted');
  const matchesBox = document.getElementById('matches');

  if (!data.ok) {
    msg.innerHTML = '<div class="error-msg">Invalid pattern: ' + escapeHtml(data.message) + '</div>';
    highlighted.innerHTML = '';
    matchesBox.value = '';
    return;
  }
  highlighted.innerHTML = data.html || '<span style="color:var(--text-dim)">No matches</span>';
  matchesBox.value = data.results.length ? data.results.join('\n') : 'No matches found.';
  msg.innerHTML = '<div class="success-msg">' + data.count + ' match' + (data.count === 1 ? '' : 'es') + ' found.</div>';
}

function runRegexInWorker(pattern, effectiveFlags, text) {
  const msg = document.getElementById('msg');

  let worker;
  try {
    worker = getRegexWorker();
  } catch (e) {
    // Worker construction failed (e.g. blocked by a restrictive environment) -- fall back
    // to running inline rather than leaving the tool completely broken.
    runRegexInline(pattern, effectiveFlags, text);
    return;
  }

  if (regexWorkerTimeout) clearTimeout(regexWorkerTimeout);
  const requestId = ++regexRequestSeq;
  msg.innerHTML = '<div class="success-msg">Running…</div>';

  worker.onmessage = function (e) {
    // Guards against a stale response from a request that already timed out and was
    // superseded by a newer one (e.g. the user clicked "Test Regex" again quickly).
    if (e.data.requestId !== requestId) return;
    clearTimeout(regexWorkerTimeout);
    applyRegexResult(e.data);
  };
  worker.onerror = function () {
    clearTimeout(regexWorkerTimeout);
    runRegexInline(pattern, effectiveFlags, text);
  };

  regexWorkerTimeout = setTimeout(function () {
    worker.terminate();
    regexWorker = null; // a terminated worker can't be reused -- next run creates a fresh one
    const highlighted = document.getElementById('highlighted');
    const matchesBox = document.getElementById('matches');
    msg.innerHTML =
      '<div class="error-msg">This pattern took too long to run against the given text ' +
      '(over ' + (REGEX_TIMEOUT_MS / 1000) + 's) — it may have catastrophic backtracking. ' +
      'Try a more specific pattern or a shorter test string.</div>';
    highlighted.innerHTML = '';
    matchesBox.value = '';
  }, REGEX_TIMEOUT_MS);

  worker.postMessage({ requestId, pattern, flags: effectiveFlags, text });
}

// Fallback path only, used when Web Workers aren't available/constructible at all -- this
// runs the same matching logic (tools/lib/regex-run.js) directly on the main thread, so
// there is no ReDoS protection in this edge case (a catastrophic-backtracking pattern
// could still hang the tab here, same as before this fix).
function runRegexInline(pattern, effectiveFlags, text) {
  applyRegexResult(RegexRunLib.runMatch(pattern, effectiveFlags, text, escapeHtml));
}

// Persistent local state (CR#6): recent-pattern history, local-only (see local-state.js).
const RECENT_KEY = 'utilx-regex-tester-recent-pattern';

function refreshRecentSelect() {
  LocalStateLib.populateRecentSelect(document.getElementById('patternRecent'), RECENT_KEY, 'Recent patterns...');
}

function runRegex() {
  const pattern = document.getElementById('pattern').value;
  const flags = RegexExplainLib.normalizeFlags(document.getElementById('flags').value);
  const text = document.getElementById('testtext').value;
  const msg = document.getElementById('msg');
  const highlighted = document.getElementById('highlighted');
  const matchesBox = document.getElementById('matches');
  msg.innerHTML = '';

  const effectiveFlags = flags.includes('g') ? flags : flags + 'g';

  // Validate flags independently of the pattern first, so a flags mistake (duplicate
  // flag, unknown flag character) is reported as a flags problem rather than folded into
  // a generic "invalid pattern" message that sends the user looking at the wrong field.
  const flagsError = RegexExplainLib.validateFlags(effectiveFlags);
  if (flagsError) {
    // Security note: RegExp constructor error messages embed the raw, attacker-controllable
    // pattern/flags text verbatim (confirmed: invalid flags containing HTML/script tags come
    // back inside e.message unescaped). This page auto-runs on load from a URL-encoded state
    // (see restoreFromUrl below), so an unescaped innerHTML assignment here would be a
    // reflected XSS triggerable by just clicking a crafted link -- always escape before
    // inserting into innerHTML, never trust "just an error message" as safe.
    msg.innerHTML = '<div class="error-msg">' + escapeHtml(flagsError) + '</div>';
    highlighted.innerHTML = '';
    matchesBox.value = '';
    return;
  }

  LocalStateLib.recordRecent(RECENT_KEY, pattern);
  refreshRecentSelect();

  if (typeof Worker === 'undefined') {
    runRegexInline(pattern, effectiveFlags, text);
    return;
  }

  runRegexInWorker(pattern, effectiveFlags, text);
}

function clearAll() {
  document.getElementById('pattern').value = '';
  document.getElementById('testtext').value = '';
  document.getElementById('highlighted').innerHTML = '';
  document.getElementById('matches').value = '';
  document.getElementById('msg').innerHTML = '';
}

function copyShareLink() {
  const url = UrlStateLib.buildShareUrl(location.origin, location.pathname, {
    pattern: document.getElementById('pattern').value,
    flags: document.getElementById('flags').value,
    text: document.getElementById('testtext').value,
  });
  const temp = document.createElement('input');
  temp.value = url;
  document.body.appendChild(temp);
  temp.select();
  document.execCommand('copy');
  document.body.removeChild(temp);
  document.getElementById('msg').innerHTML = '<div class="success-msg">Shareable link copied to clipboard.</div>';
}

document.addEventListener('keydown', (e) => {
  if (ShortcutsLib.isRunShortcut(e)) {
    e.preventDefault();
    runRegex();
  }
});

(function restoreFromUrl() {
  const state = UrlStateLib.decodeState(location.search);
  if (!state) return;
  if (typeof state.pattern === 'string') document.getElementById('pattern').value = state.pattern;
  if (typeof state.flags === 'string') document.getElementById('flags').value = state.flags;
  if (typeof state.text === 'string') document.getElementById('testtext').value = state.text;
  if (state.pattern) { runRegex(); explainPattern(); }
})();

OutputToolbarLib.init();

refreshRecentSelect();
document.getElementById('patternRecent').addEventListener('change', (e) => {
  if (!e.target.value) return;
  document.getElementById('pattern').value = e.target.value;
  runRegex();
  explainPattern();
  e.target.value = '';
});
</script>
</BaseLayout>
