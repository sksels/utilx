---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OutputToolbar from '../../components/OutputToolbar.astro';
import LocalBadge from '../../components/LocalBadge.astro';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Password & UUID v4/v7 Generator — Bulk, Secure",
  "url": "https://utilx.tools/tools/password-generator.html",
  "description": "Generate strong random passwords and UUID v4 or time-sortable UUID v7 identifiers in bulk, using your browser's cryptographically secure random number generator. No signup, nothing sent over the network.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any (runs in browser)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "isAccessibleForFree": true,
  "publisher": {
    "@type": "Organization",
    "name": "UtilX",
    "url": "https://utilx.tools/"
  }
}, null, 2);
---
<BaseLayout
  title="Password & UUID v4/v7 Generator — Bulk, Secure | UtilX"
  description="Generate strong random passwords and UUID v4 or time-sortable UUID v7 identifiers in bulk, using your browser's cryptographically secure random number generator. No signup, nothing sent over the network."
  canonicalPath="/tools/password-generator.html"
  pwa={true}
  jsonLd={jsonLd}
>
<Fragment slot="head-extra">
<script is:inline src="lib/password.js"></script>
<script is:inline src="lib/shortcuts.js"></script>
<script is:inline src="lib/html-escape.js"></script>
<script is:inline src="/output-toolbar.js"></script>
</Fragment>

<main>
  <div class="wrap">
    <div class="breadcrumb"><a href="/index.html">Tools</a> / Password &amp; UUID Generator</div>
    <h1>Password &amp; UUID Generator</h1>
    <p class="lede">Generated locally with <code>crypto.getRandomValues</code> — the browser's cryptographically secure RNG. Nothing is transmitted or logged.</p>
    <div><LocalBadge /></div>

    <div class="card">
      <h2 style="margin-top:0;">Password</h2>
      <label for="length">Length: <span id="lengthVal">16</span></label>
      <input type="range" id="length" min="4" max="64" value="16" oninput="document.getElementById('lengthVal').textContent=this.value">

      <div class="checkbox-row"><input type="checkbox" id="upper" checked><label for="upper">Uppercase (A-Z)</label></div>
      <div class="checkbox-row"><input type="checkbox" id="lower" checked><label for="lower">Lowercase (a-z)</label></div>
      <div class="checkbox-row"><input type="checkbox" id="numbers" checked><label for="numbers">Numbers (0-9)</label></div>
      <div class="checkbox-row"><input type="checkbox" id="symbols" checked><label for="symbols">Symbols (!@#$...)</label></div>
      <div class="checkbox-row"><input type="checkbox" id="excludeAmbiguous"><label for="excludeAmbiguous">Exclude ambiguous characters (l, 1, I, O, 0)</label></div>

      <div>
        <button onclick="generatePassword()">Generate Password</button>
      </div>
      <p style="color:var(--text-dim); font-size:0.8rem; margin:6px 0 0;">Tip: press Ctrl+Enter (Cmd+Enter on Mac) while focused in this section to generate.</p>
      <div class="output-box">
        <div class="output-target">
          <input type="text" id="passwordOut" readonly>
          <OutputToolbar targetId="passwordOut" />
        </div>
      </div>
      <div id="strengthMsg"></div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">UUID Generator</h2>
      <label for="uuidVersion">Version</label>
      <select id="uuidVersion">
        <option value="v4">UUID v4 (fully random)</option>
        <option value="v7">UUID v7 (time-sortable)</option>
      </select>
      <div>
        <button onclick="generateUuid()">Generate UUID</button>
        <button class="secondary" onclick="generateUuidBulk(10)">Generate 10</button>
        <button class="secondary" onclick="generateUuidBulk(100)">Generate 100</button>
      </div>
      <p style="color:var(--text-dim); font-size:0.8rem; margin:6px 0 0;">Tip: press Ctrl+Enter (Cmd+Enter on Mac) while focused in this section to generate one UUID.</p>
      <div class="output-box">
        <div class="output-target">
          <textarea id="uuidOut" rows="4" readonly></textarea>
          <OutputToolbar targetId="uuidOut" download={true} downloadFilename="uuids.txt" />
        </div>
      </div>
      <p style="color:var(--text-dim); font-size:0.85rem;"><strong>v4</strong> is fully random — use it by default. <strong>v7</strong> embeds a millisecond timestamp so IDs sort chronologically, which makes them better as database primary keys (better index locality than random v4). <strong>v1</strong> also encodes a timestamp but includes a MAC-address-derived field, which v7 avoids.</p>
    </div>


    <h2>Why local generation matters</h2>
    <p>Passwords generated on a server, or sent over the network for "checking," can be logged. This tool uses <code>window.crypto.getRandomValues()</code>, the same cryptographic RNG browsers use for TLS, entirely on your device — nothing is ever sent anywhere.</p>
    <p>Related tool: need to safely embed a generated secret in a URL or config file? The <a href="/tools/base64-tool.html">Base64 Encoder / Decoder</a> can help encode it.</p>
  </div>
</main>

<script is:inline>
// Security note: never insert an Error's .message into innerHTML unescaped -- consistent
// with the other tools, even though this page has no free-text input feeding these paths
// today (length/checkbox-driven only), so it isn't currently reachable with attacker text.
const escapeHtml = HtmlEscapeLib.escapeHtml;

function generatePassword() {
  const length = Number(document.getElementById('length').value);
  const charset = PasswordLib.buildCharset({
    upper: document.getElementById('upper').checked,
    lower: document.getElementById('lower').checked,
    numbers: document.getElementById('numbers').checked,
    symbols: document.getElementById('symbols').checked,
    excludeAmbiguous: document.getElementById('excludeAmbiguous').checked,
  });

  const msg = document.getElementById('strengthMsg');
  if (!charset) {
    msg.innerHTML = '<div class="error-msg">Select at least one character set.</div>';
    document.getElementById('passwordOut').value = '';
    return;
  }

  try {
    const randomValues = new Uint32Array(length);
    window.crypto.getRandomValues(randomValues);
    document.getElementById('passwordOut').value = PasswordLib.pickFromCharset(charset, length, randomValues);

    const entropy = PasswordLib.computeEntropy(charset.length, length);
    const strength = PasswordLib.strengthLabel(entropy);
    msg.innerHTML = '<div class="success-msg">' + strength + ' — approx. ' + Math.round(entropy) + ' bits of entropy.</div>';
  } catch (e) {
    msg.innerHTML = '<div class="error-msg">' + escapeHtml(e.message) + '</div>';
    document.getElementById('passwordOut').value = '';
  }
}

function generateUuidV7() {
  const rand = new Uint8Array(10);
  crypto.getRandomValues(rand);
  return PasswordLib.generateUuidV7(Date.now(), rand);
}

function makeUuid() {
  const version = document.getElementById('uuidVersion').value;
  return version === 'v7' ? generateUuidV7() : crypto.randomUUID();
}

function generateUuid() {
  try {
    document.getElementById('uuidOut').value = makeUuid();
  } catch (e) {
    document.getElementById('uuidOut').value = '';
    alert('Could not generate a UUID: ' + e.message);
  }
}

function generateUuidBulk(count) {
  try {
    const uuids = [];
    for (let i = 0; i < count; i++) {
      uuids.push(makeUuid());
    }
    document.getElementById('uuidOut').value = uuids.join('\n');
  } catch (e) {
    document.getElementById('uuidOut').value = '';
    alert('Could not generate UUIDs: ' + e.message);
  }
}

const PASSWORD_FIELD_IDS = ['length', 'upper', 'lower', 'numbers', 'symbols', 'excludeAmbiguous', 'passwordOut'];
const UUID_FIELD_IDS = ['uuidVersion', 'uuidOut'];

document.addEventListener('keydown', (e) => {
  if (!ShortcutsLib.isRunShortcut(e)) return;
  const activeId = document.activeElement && document.activeElement.id;
  if (UUID_FIELD_IDS.includes(activeId)) {
    e.preventDefault();
    generateUuid();
  } else if (PASSWORD_FIELD_IDS.includes(activeId)) {
    e.preventDefault();
    generatePassword();
  }
});

generatePassword();
generateUuid();
OutputToolbarLib.init();
</script>
</BaseLayout>
