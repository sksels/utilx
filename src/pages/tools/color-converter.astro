---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalBadge from '../../components/LocalBadge.astro';
import InputToolbar from '../../components/InputToolbar.astro';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Color Converter + Image Picker & Contrast Checker",
  "url": "https://utilx.tools/tools/color-converter.html",
  "description": "Convert HEX, RGB, and HSL instantly, sample any color directly from an uploaded image, and check WCAG contrast ratios for accessibility — all free and browser-based.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any (runs in browser)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "isAccessibleForFree": true,
  "publisher": {
    "@type": "Organization",
    "name": "UtilX",
    "url": "https://utilx.tools/"
  }
}, null, 2);
---
<BaseLayout
  title="Color Converter + Image Picker & Contrast Checker | UtilX"
  description="Convert HEX, RGB, and HSL instantly, sample any color directly from an uploaded image, and check WCAG contrast ratios for accessibility — all free and browser-based."
  canonicalPath="/tools/color-converter.html"
  pwa={true}
  jsonLd={jsonLd}
>
<Fragment slot="head-extra">
<script is:inline src="lib/color.js"></script>
<script is:inline src="lib/url-state.js"></script>
<script is:inline src="/local-state.js"></script>
</Fragment>

<main>
  <div class="wrap">
    <div class="breadcrumb"><a href="/index.html">Tools</a> / Color Converter</div>
    <h1>Color Converter</h1>
    <p class="lede">Enter a color in any format below — the others update automatically.</p>
    <div><LocalBadge text="Processed 100% locally — uploaded images never leave this tab" /></div>

    <div class="card">
      <div id="swatch" class="color-swatch" style="background:#5b8cff;"></div>

      <div class="field-header">
        <label for="hex">HEX</label>
        <select id="hexRecent" class="recent-select" title="Load a recent color" disabled></select>
      </div>
      <input type="text" id="hex" value="#5b8cff">

      <label for="rgb">RGB</label>
      <input type="text" id="rgb" value="rgb(91, 140, 255)">

      <label for="hsl">HSL</label>
      <div class="input-target">
        <input type="text" id="hsl" value="hsl(222, 100%, 68%)">
        <InputToolbar inline>
          <button class="toolbar-btn" onclick="copyShareLink()" title="Copy shareable link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
          <button class="toolbar-btn" onclick="clearAll()" title="Clear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </InputToolbar>
      </div>

      <div id="msg"></div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Sample a color from an image</h2>
      <p style="color:var(--text-dim); margin-top:-8px;">Upload an image, then click anywhere on it to pick that pixel's color. Nothing is uploaded anywhere — the image stays in your browser.</p>
      <input type="file" id="imageInput" accept="image/*">
      <canvas id="imageCanvas" style="max-width:100%; margin-top:12px; border-radius:8px; border:1px solid var(--border); cursor:crosshair; display:none;"></canvas>
      <div id="imageMsg"></div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Contrast checker (WCAG)</h2>
      <p style="color:var(--text-dim); margin-top:-8px;">Check whether a text/background color pair meets accessibility contrast requirements.</p>
      <div class="two-col">
        <div>
          <label for="fgColor">Text color</label>
          <input type="text" id="fgColor" value="#e6e8ef">
        </div>
        <div>
          <label for="bgColor">Background color</label>
          <input type="text" id="bgColor" value="#0f1117">
        </div>
      </div>
      <div id="contrastPreview" style="padding:20px; border-radius:8px; margin-top:12px; font-size:1.1rem;">The quick brown fox jumps over the lazy dog</div>
      <div id="contrastResult" style="margin-top:12px;"></div>
    </div>

    <p>Related tool: embedding this color or an image as a Data URI? The <a href="/tools/base64-tool.html">Base64 Encoder / Decoder</a> can help encode it.</p>
  </div>
</main>

<script is:inline>
const hexEl = document.getElementById('hex');
const rgbEl = document.getElementById('rgb');
const hslEl = document.getElementById('hsl');
const swatch = document.getElementById('swatch');
const msg = document.getElementById('msg');

const hexToRgb = ColorLib.hexToRgb;
const rgbToHex = ColorLib.rgbToHex;
const rgbToHsl = ColorLib.rgbToHsl;
const hslToRgb = ColorLib.hslToRgb;

// Persistent local state (CR#6): recent hex-color history, local-only.
const RECENT_KEY = 'utilx-color-converter-recent-hex';

function refreshRecentSelect() {
  LocalStateLib.populateRecentSelect(document.getElementById('hexRecent'), RECENT_KEY, 'Recent colors...');
}

function updateFrom(source) {
  let rgb;
  let alpha; // undefined when the input carried no alpha channel
  let errorMsg = 'Could not parse that value.';
  try {
    if (source === 'hex') {
      rgb = hexToRgb(hexEl.value);
      if (!rgb) {
        errorMsg = 'Enter a valid hex color: 3, 4, 6, or 8 digits, e.g. #5b8cff or #5b8cff80 (last 2 digits = optional alpha).';
        throw new Error('bad hex');
      }
      alpha = rgb.a;
    } else if (source === 'rgb') {
      rgb = ColorLib.parseRgbString(rgbEl.value);
      if (!rgb) {
        errorMsg = 'Enter RGB as three numbers 0-255, e.g. rgb(91, 140, 255) -- optionally add a 4th alpha value 0-1, e.g. rgba(91, 140, 255, 0.5).';
        throw new Error('bad rgb');
      }
      alpha = rgb.a;
    } else if (source === 'hsl') {
      const parsed = ColorLib.parseHslString(hslEl.value);
      if (!parsed) {
        errorMsg = 'Enter HSL as a hue 0-360 and saturation/lightness 0-100%, e.g. hsl(222, 100%, 68%) -- optionally add a 4th alpha value 0-1, e.g. hsla(222, 100%, 68%, 0.5).';
        throw new Error('bad hsl');
      }
      rgb = hslToRgb(parsed.h, parsed.s, parsed.l);
      alpha = parsed.a;
    }
  } catch (e) {
    msg.innerHTML = '<div class="error-msg">' + errorMsg + '</div>';
    return;
  }

  msg.innerHTML = '<div class="success-msg">Converted.</div>';
  const hex = rgbToHex(rgb.r, rgb.g, rgb.b, alpha);
  const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);

  if (source !== 'hex') hexEl.value = hex;
  if (source !== 'rgb') {
    rgbEl.value = alpha === undefined
      ? 'rgb(' + rgb.r + ', ' + rgb.g + ', ' + rgb.b + ')'
      : 'rgba(' + rgb.r + ', ' + rgb.g + ', ' + rgb.b + ', ' + alpha + ')';
  }
  if (source !== 'hsl') {
    hslEl.value = alpha === undefined
      ? 'hsl(' + hsl.h + ', ' + hsl.s + '%, ' + hsl.l + '%)'
      : 'hsla(' + hsl.h + ', ' + hsl.s + '%, ' + hsl.l + '%, ' + alpha + ')';
  }
  swatch.style.background = alpha === undefined
    ? 'rgb(' + rgb.r + ', ' + rgb.g + ', ' + rgb.b + ')'
    : 'rgba(' + rgb.r + ', ' + rgb.g + ', ' + rgb.b + ', ' + alpha + ')';

  LocalStateLib.recordRecent(RECENT_KEY, hex);
  refreshRecentSelect();
}

hexEl.addEventListener('input', () => updateFrom('hex'));
rgbEl.addEventListener('input', () => updateFrom('rgb'));
hslEl.addEventListener('input', () => updateFrom('hsl'));

// --- Image color sampling ---
const imageInput = document.getElementById('imageInput');
const imageCanvas = document.getElementById('imageCanvas');
const imageMsg = document.getElementById('imageMsg');
const imageCtx = imageCanvas.getContext('2d', { willReadFrequently: true });

imageInput.addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const img = new Image();
  const reader = new FileReader();
  reader.onload = (ev) => { img.src = ev.target.result; };
  img.onload = () => {
    const maxWidth = 600;
    const scale = Math.min(1, maxWidth / img.width);
    imageCanvas.width = img.width * scale;
    imageCanvas.height = img.height * scale;
    imageCtx.drawImage(img, 0, 0, imageCanvas.width, imageCanvas.height);
    imageCanvas.style.display = 'block';
    imageMsg.innerHTML = '<div class="success-msg">Image loaded — click anywhere on it to sample a color.</div>';
  };
  reader.readAsDataURL(file);
});

imageCanvas.addEventListener('click', (e) => {
  const rect = imageCanvas.getBoundingClientRect();
  const scaleX = imageCanvas.width / rect.width;
  const scaleY = imageCanvas.height / rect.height;
  const x = Math.floor((e.clientX - rect.left) * scaleX);
  const y = Math.floor((e.clientY - rect.top) * scaleY);
  const pixel = imageCtx.getImageData(x, y, 1, 1).data;
  const pixelAlpha = pixel[3] < 255 ? Math.round((pixel[3] / 255) * 100) / 100 : undefined;
  const hex = rgbToHex(pixel[0], pixel[1], pixel[2], pixelAlpha);
  hexEl.value = hex;
  updateFrom('hex');
  imageMsg.innerHTML = '<div class="success-msg">Sampled ' + hex + ' — loaded into the converter above.</div>';
});

// --- WCAG contrast checker ---
const fgColorEl = document.getElementById('fgColor');
const bgColorEl = document.getElementById('bgColor');
const contrastPreview = document.getElementById('contrastPreview');
const contrastResult = document.getElementById('contrastResult');

const contrastRatio = ColorLib.contrastRatio;
const parseAnyColor = ColorLib.parseAnyColor;

function updateContrast() {
  const fgRaw = parseAnyColor(fgColorEl.value);
  const bgRaw = parseAnyColor(bgColorEl.value);
  if (!fgRaw || !bgRaw) {
    contrastResult.innerHTML = '<div class="error-msg">Enter valid colors for both fields -- hex (#5b8cff, or #5b8cff80 with alpha) or RGB with each channel 0-255.</div>';
    return;
  }

  // Contrast is only rigorously defined for opaque colors, so translucent inputs are
  // composited over a white backdrop first (see ColorLib.compositeOverWhite).
  const hasAlpha = (fgRaw.a !== undefined && fgRaw.a < 1) || (bgRaw.a !== undefined && bgRaw.a < 1);
  const fg = ColorLib.compositeOverWhite(fgRaw);
  const bg = ColorLib.compositeOverWhite(bgRaw);

  contrastPreview.style.color = rgbToHex(fg.r, fg.g, fg.b);
  contrastPreview.style.background = rgbToHex(bg.r, bg.g, bg.b);

  const ratio = contrastRatio(fg, bg);
  const passAANormal = ratio >= 4.5;
  const passAALarge = ratio >= 3;
  const passAAANormal = ratio >= 7;
  const passAAALarge = ratio >= 4.5;

  const badge = (pass) => '<span class="' + (pass ? 'success-msg' : 'error-msg') + '" style="margin:0;">' + (pass ? 'Pass' : 'Fail') + '</span>';

  const alphaNote = hasAlpha
    ? '<p style="color:var(--text-dim); font-size:0.85rem; margin:10px 0 0;">One or both colors are translucent, so contrast is calculated as if composited over a white background.</p>'
    : '';

  contrastResult.innerHTML =
    '<table class="ref-table">' +
    '<tr><th>Ratio</th><td>' + ratio.toFixed(2) + ':1</td></tr>' +
    '<tr><th>AA — normal text</th><td>' + badge(passAANormal) + ' (needs 4.5:1)</td></tr>' +
    '<tr><th>AA — large text</th><td>' + badge(passAALarge) + ' (needs 3:1)</td></tr>' +
    '<tr><th>AAA — normal text</th><td>' + badge(passAAANormal) + ' (needs 7:1)</td></tr>' +
    '<tr><th>AAA — large text</th><td>' + badge(passAAALarge) + ' (needs 4.5:1)</td></tr>' +
    '</table>' + alphaNote;
}

fgColorEl.addEventListener('input', updateContrast);
bgColorEl.addEventListener('input', updateContrast);
updateContrast();

function clearAll() {
  hexEl.value = '';
  rgbEl.value = '';
  hslEl.value = '';
  swatch.style.background = 'transparent';
  msg.innerHTML = '';
}

function copyShareLink() {
  const url = UrlStateLib.buildShareUrl(location.origin, location.pathname, {
    hex: hexEl.value,
  });
  const temp = document.createElement('input');
  temp.value = url;
  document.body.appendChild(temp);
  temp.select();
  document.execCommand('copy');
  document.body.removeChild(temp);
  msg.innerHTML = '<div class="success-msg">Shareable link copied to clipboard.</div>';
}

refreshRecentSelect();
document.getElementById('hexRecent').addEventListener('change', (e) => {
  if (!e.target.value) return;
  hexEl.value = e.target.value;
  updateFrom('hex');
  e.target.value = '';
});

(function restoreFromUrl() {
  const state = UrlStateLib.decodeState(location.search);
  if (!state || typeof state.hex !== 'string') return;
  hexEl.value = state.hex;
  updateFrom('hex');
})();
</script>
</BaseLayout>
