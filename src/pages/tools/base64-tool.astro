---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OutputToolbar from '../../components/OutputToolbar.astro';
import InputToolbar from '../../components/InputToolbar.astro';
import LocalBadge from '../../components/LocalBadge.astro';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Base64 Encoder & Decoder + JWT Decoder",
  "url": "https://utilx.tools/tools/base64-tool.html",
  "description": "Encode text to Base64, decode Base64 to text or a downloadable file, or decode a JWT to inspect its header and payload — entirely in your browser. Supports UTF-8 correctly, unlike plain btoa/atob.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any (runs in browser)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "isAccessibleForFree": true,
  "publisher": {
    "@type": "Organization",
    "name": "UtilX",
    "url": "https://utilx.tools/"
  }
}, null, 2);
---
<BaseLayout
  title="Base64 Encoder & Decoder + JWT Decoder | UtilX"
  description="Encode text to Base64, decode Base64 to text or a downloadable file, or decode a JWT to inspect its header and payload — entirely in your browser. Supports UTF-8 correctly, unlike plain btoa/atob."
  canonicalPath="/tools/base64-tool.html"
  pwa={true}
  jsonLd={jsonLd}
>
<Fragment slot="head-extra">
<script is:inline src="lib/base64.js"></script>
<script is:inline src="lib/shortcuts.js"></script>
<script is:inline src="lib/url-state.js"></script>
<script is:inline src="lib/html-escape.js"></script>
<script is:inline src="/output-toolbar.js"></script>
</Fragment>

<main>
  <div class="wrap">
    <div class="breadcrumb"><a href="/index.html">Tools</a> / Base64 Encoder / Decoder</div>
    <h1>Base64 Encoder / Decoder</h1>
    <p class="lede">Encode or decode text using Base64, with correct UTF-8 handling (emoji and accented characters included).</p>
    <div><LocalBadge text="Processed 100% locally — JWTs and secrets never leave this tab" /></div>

    <div class="card">
      <label for="input">Input</label>
      <div class="input-target">
        <textarea id="input" rows="8" placeholder="Type or paste text here..."></textarea>
        <InputToolbar>
          <button class="toolbar-btn" onclick="encode()" title="Encode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <button class="toolbar-btn" onclick="decode()" title="Decode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </button>
          <button class="toolbar-btn" onclick="swap()" title="Swap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3l4 4-4 4"/><path d="M3 7h18"/><path d="M7 21l-4-4 4-4"/><path d="M21 17H3"/></svg>
          </button>
          <button class="toolbar-btn" onclick="copyShareLink()" title="Copy shareable link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
          <button class="toolbar-btn" onclick="clearAll()" title="Clear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </InputToolbar>
      </div>
      <p style="color:var(--text-dim); font-size:0.8rem; margin:6px 0 0;">Tip: press Ctrl+Enter (Cmd+Enter on Mac) to encode. In the JWT box below, it decodes instead.</p>

      <div id="msg"></div>

      <div class="output-box">
        <label for="output">Output</label>
        <div class="output-target">
          <textarea id="output" rows="8"></textarea>
          <OutputToolbar targetId="output" download={true} downloadFilename="output.txt" />
        </div>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">JWT Decoder</h2>
      <p style="color:var(--text-dim); margin-top:-8px;">JWTs are just Base64url-encoded JSON under the hood — paste one below to see the header and payload decoded. This does not verify the signature (that requires the secret key), it just decodes the readable parts.</p>
      <label for="jwtInput">JWT</label>
      <div class="input-target">
        <textarea id="jwtInput" rows="4" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"></textarea>
        <InputToolbar>
          <button class="toolbar-btn" onclick="decodeJwt()" title="Decode JWT">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </button>
          <button class="toolbar-btn" onclick="clearJwt()" title="Clear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </InputToolbar>
      </div>
      <div id="jwtMsg"></div>
      <div class="output-box">
        <label>Header</label>
        <div class="output-target">
          <textarea id="jwtHeader" rows="4" readonly></textarea>
          <OutputToolbar targetId="jwtHeader" />
        </div>
      </div>
      <div class="output-box">
        <label>Payload</label>
        <div class="output-target">
          <textarea id="jwtPayload" rows="6" readonly></textarea>
          <OutputToolbar targetId="jwtPayload" />
        </div>
      </div>
      <div class="output-box">
        <label>Signature (raw, unverified)</label>
        <div class="output-target">
          <input type="text" id="jwtSignature" readonly>
          <OutputToolbar targetId="jwtSignature" inline={true} />
        </div>
      </div>
    </div>


    <p>Curious what Base64 is actually for? Read <a href="/guides/understanding-base64.html">Understanding Base64</a>.</p>
    <p>Related tool: decoded a JWT payload above? Format the resulting JSON with the <a href="/tools/json-formatter.html">JSON Formatter &amp; Validator</a>.</p>
  </div>
</main>

<script is:inline>
// Security note: never insert an Error's .message into innerHTML unescaped. JS engine and
// library error messages can embed raw, attacker-controllable input verbatim, and this page
// auto-runs on load from a URL-encoded state (see restoreFromUrl below) -- an unescaped
// assignment here would be a reflected-XSS vector triggerable by just clicking a crafted link.
const escapeHtml = HtmlEscapeLib.escapeHtml;

function encode() {
  const input = document.getElementById('input').value;
  const msg = document.getElementById('msg');
  try {
    document.getElementById('output').value = Base64Lib.encodeUtf8ToBase64(input);
    msg.innerHTML = '<div class="success-msg">Encoded.</div>';
  } catch (e) {
    msg.innerHTML = '<div class="error-msg">' + escapeHtml(e.message) + '</div>';
  }
}

function decode() {
  const input = document.getElementById('input').value;
  const msg = document.getElementById('msg');
  try {
    document.getElementById('output').value = Base64Lib.decodeBase64ToUtf8(input);
    msg.innerHTML = '<div class="success-msg">Decoded.</div>';
  } catch (e) {
    msg.innerHTML = '<div class="error-msg">' + escapeHtml(e.message) + '</div>';
  }
}

function decodeJwt() {
  const input = document.getElementById('jwtInput').value.trim();
  const msg = document.getElementById('jwtMsg');
  const headerOut = document.getElementById('jwtHeader');
  const payloadOut = document.getElementById('jwtPayload');
  const sigOut = document.getElementById('jwtSignature');
  msg.innerHTML = '';

  try {
    const { header, payload, signature } = Base64Lib.decodeJwt(input);
    headerOut.value = JSON.stringify(header, null, 2);
    payloadOut.value = JSON.stringify(payload, null, 2);
    sigOut.value = signature;
    msg.innerHTML = '<div class="success-msg">Decoded. Signature shown as-is — not verified.</div>';
  } catch (e) {
    msg.innerHTML = '<div class="error-msg">' + escapeHtml(e.message) + '</div>';
    headerOut.value = '';
    payloadOut.value = '';
    sigOut.value = '';
  }
}

function swap() {
  const input = document.getElementById('input');
  const output = document.getElementById('output');
  const tmp = input.value;
  input.value = output.value;
  output.value = tmp;
}

function clearAll() {
  document.getElementById('input').value = '';
  document.getElementById('output').value = '';
  document.getElementById('msg').innerHTML = '';
}

function clearJwt() {
  document.getElementById('jwtInput').value = '';
  document.getElementById('jwtHeader').value = '';
  document.getElementById('jwtPayload').value = '';
  document.getElementById('jwtSignature').value = '';
  document.getElementById('jwtMsg').innerHTML = '';
}

function copyShareLink() {
  const url = UrlStateLib.buildShareUrl(location.origin, location.pathname, {
    input: document.getElementById('input').value,
  });
  const temp = document.createElement('input');
  temp.value = url;
  document.body.appendChild(temp);
  temp.select();
  document.execCommand('copy');
  document.body.removeChild(temp);
  document.getElementById('msg').innerHTML = '<div class="success-msg">Shareable link copied to clipboard.</div>';
}

document.addEventListener('keydown', (e) => {
  if (!ShortcutsLib.isRunShortcut(e)) return;
  e.preventDefault();
  if (document.activeElement && document.activeElement.id === 'jwtInput') {
    decodeJwt();
  } else {
    encode();
  }
});

(function restoreFromUrl() {
  const state = UrlStateLib.decodeState(location.search);
  if (!state || typeof state.input !== 'string') return;
  document.getElementById('input').value = state.input;
})();

OutputToolbarLib.init();
</script>
</BaseLayout>
