---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OutputToolbar from '../../components/OutputToolbar.astro';
import LocalBadge from '../../components/LocalBadge.astro';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Cron Expression Builder — Standard, Quartz & Kubernetes",
  "url": "https://utilx.tools/tools/cron-builder.html",
  "description": "Build and decode cron expressions with dropdowns. Auto-detects standard cron (Linux/Kubernetes CronJob), Quartz syntax (Java/Spring, with seconds and named days/months), and exports a ready-to-use Kubernetes CronJob YAML manifest.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any (runs in browser)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "isAccessibleForFree": true,
  "publisher": {
    "@type": "Organization",
    "name": "UtilX",
    "url": "https://utilx.tools/"
  }
}, null, 2);
---
<BaseLayout
  title="Cron Expression Builder — Standard, Quartz & Kubernetes | UtilX"
  description="Build and decode cron expressions with dropdowns. Auto-detects standard cron (Linux/Kubernetes CronJob), Quartz syntax (Java/Spring, with seconds and named days/months), and exports a ready-to-use Kubernetes CronJob YAML manifest."
  canonicalPath="/tools/cron-builder.html"
  pwa={true}
  jsonLd={jsonLd}
>
<Fragment slot="head-extra">
<script is:inline src="lib/cron.js"></script>
<script is:inline src="lib/shortcuts.js"></script>
<script is:inline src="lib/url-state.js"></script>
<script is:inline src="/output-toolbar.js"></script>
<script is:inline src="/local-state.js"></script>
</Fragment>

<main>
  <div class="wrap">
    <div class="breadcrumb"><a href="/index.html">Tools</a> / Cron Builder</div>
    <h1>Cron Expression Builder &amp; Decoder</h1>
    <p class="lede">Build a 5-field cron expression with dropdowns, or paste one in — the decoder auto-detects standard cron (Linux/Kubernetes CronJob), or Quartz syntax (6-7 fields with seconds, used by Java/Spring schedulers).</p>
    <div><LocalBadge /></div>

    <div class="card">
      <h2 style="margin-top:0;">Build</h2>
      <div class="two-col">
        <div>
          <label for="minute">Minute (0-59, * for every)</label>
          <input type="text" id="minute" value="0">
        </div>
        <div>
          <label for="hour">Hour (0-23, * for every)</label>
          <input type="text" id="hour" value="*">
        </div>
      </div>
      <div class="two-col">
        <div>
          <label for="dom">Day of month (1-31, * for every)</label>
          <input type="text" id="dom" value="*">
        </div>
        <div>
          <label for="month">Month (1-12, * for every)</label>
          <input type="text" id="month" value="*">
        </div>
      </div>
      <label for="dow">Day of week (0-6, Sun=0, * for every)</label>
      <div class="input-target">
        <input type="text" id="dow" value="*">
        <div class="input-toolbar inline">
          <button class="toolbar-btn" onclick="buildCron()" title="Build Expression">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v16l13-8Z"/></svg>
          </button>
          <button class="toolbar-btn" onclick="clearBuild()" title="Clear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      <div id="buildMsg"></div>
      <div class="output-box">
        <label>Cron expression</label>
        <div class="output-target">
          <input type="text" id="built" readonly>
          <OutputToolbar targetId="built" inline={true} />
        </div>
      </div>
      <div class="output-box">
        <label>As a Kubernetes CronJob snippet</label>
        <div class="output-target">
          <textarea id="k8sYaml" rows="4" readonly style="font-family:'SF Mono',Menlo,Consolas,monospace;"></textarea>
          <OutputToolbar targetId="k8sYaml" download={true} downloadFilename="cronjob.yaml" />
        </div>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Decode</h2>
      <div class="field-header">
        <label for="decodeInput">Paste a cron expression</label>
        <select id="decodeRecent" class="recent-select" title="Load a recent expression" disabled></select>
      </div>
      <div class="input-target">
        <input type="text" id="decodeInput" placeholder="0 9 * * 1-5">
        <div class="input-toolbar inline">
          <button class="toolbar-btn" onclick="decodeCron()" title="Decode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v16l13-8Z"/></svg>
          </button>
          <button class="toolbar-btn" onclick="copyShareLink()" title="Copy shareable link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
          <button class="toolbar-btn" onclick="clearDecode()" title="Clear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      <p style="color:var(--text-dim); font-size:0.8rem; margin:6px 0 0;">Tip: press Ctrl+Enter (Cmd+Enter on Mac) to build or decode, depending on which field you're in.</p>
      <div id="decodeMsg"></div>
      <div class="output-box">
        <label>Plain-English explanation</label>
        <div class="output-target">
          <textarea id="decoded" rows="4" readonly></textarea>
          <OutputToolbar targetId="decoded" />
        </div>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Common schedules</h2>
      <p style="color:var(--text-dim); margin-top:-8px;">Click any example to load it into the decoder above.</p>
      <table class="ref-table">
        <tr><th>Schedule</th><th>Expression</th><th></th></tr>
        <tr><td>Every 15 minutes</td><td><code>*/15 * * * *</code></td><td><button class="secondary" onclick="loadExample('*/15 * * * *')">Use</button></td></tr>
        <tr><td>Every hour</td><td><code>0 * * * *</code></td><td><button class="secondary" onclick="loadExample('0 * * * *')">Use</button></td></tr>
        <tr><td>Every day at midnight</td><td><code>0 0 * * *</code></td><td><button class="secondary" onclick="loadExample('0 0 * * *')">Use</button></td></tr>
        <tr><td>Every weekday at 9am</td><td><code>0 9 * * 1-5</code></td><td><button class="secondary" onclick="loadExample('0 9 * * 1-5')">Use</button></td></tr>
        <tr><td>Every Monday at 9am</td><td><code>0 9 * * 1</code></td><td><button class="secondary" onclick="loadExample('0 9 * * 1')">Use</button></td></tr>
        <tr><td>Every 6 hours</td><td><code>0 */6 * * *</code></td><td><button class="secondary" onclick="loadExample('0 */6 * * *')">Use</button></td></tr>
        <tr><td>First of every month</td><td><code>0 0 1 * *</code></td><td><button class="secondary" onclick="loadExample('0 0 1 * *')">Use</button></td></tr>
      </table>
    </div>


    <p>New to cron syntax? Read the full <a href="/guides/cron-syntax-guide.html">cron syntax guide</a>.</p>
    <p>Related tool: need to validate a job name or log pattern alongside your schedule? Try the <a href="/tools/regex-tester.html">Regex Tester</a>.</p>
  </div>
</main>

<script is:inline>
function loadExample(expr) {
  document.getElementById('decodeInput').value = expr;
  decodeCron();
  document.getElementById('decodeInput').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function buildCron() {
  const m = document.getElementById('minute').value.trim() || '*';
  const h = document.getElementById('hour').value.trim() || '*';
  const dom = document.getElementById('dom').value.trim() || '*';
  const mon = document.getElementById('month').value.trim() || '*';
  const dow = document.getElementById('dow').value.trim() || '*';
  const buildMsg = document.getElementById('buildMsg');

  const errors = CronLib.validateBuildFields(m, h, dom, mon, dow);
  if (errors.length) {
    buildMsg.innerHTML = '<div class="error-msg">' + errors.join('<br>') + '</div>';
    document.getElementById('built').value = '';
    document.getElementById('k8sYaml').value = '';
    return;
  }

  buildMsg.innerHTML = '';
  const expr = CronLib.buildCronExpression(m, h, dom, mon, dow);
  document.getElementById('built').value = expr;
  document.getElementById('k8sYaml').value = CronLib.buildK8sCronJobYaml(expr);
}

function clearBuild() {
  BUILD_FIELD_IDS.forEach((id) => { document.getElementById(id).value = '*'; });
  document.getElementById('minute').value = '0';
  document.getElementById('built').value = '';
  document.getElementById('k8sYaml').value = '';
  document.getElementById('buildMsg').innerHTML = '';
}

function clearDecode() {
  document.getElementById('decodeInput').value = '';
  document.getElementById('decoded').value = '';
  document.getElementById('decodeMsg').innerHTML = '';
}

// Persistent local state (CR#6): recent decoded-expression history, local-only.
const RECENT_KEY = 'utilx-cron-builder-recent-decode';

function refreshRecentSelect() {
  LocalStateLib.populateRecentSelect(document.getElementById('decodeRecent'), RECENT_KEY, 'Recent expressions...');
}

function decodeCron() {
  const input = document.getElementById('decodeInput').value.trim();
  const msg = document.getElementById('decodeMsg');
  const out = document.getElementById('decoded');
  const parts = input.split(/\s+/).filter(Boolean);

  if (input) {
    LocalStateLib.recordRecent(RECENT_KEY, input);
    refreshRecentSelect();
  }

  if (parts.length === 5) {
    const fieldErrors = CronLib.validateBuildFields(parts[0], parts[1], parts[2], parts[3], parts[4]);
    const warning = fieldErrors.length
      ? '<div class="error-msg" style="margin-top:6px;">Heads up -- this isn\'t a fully valid standard cron expression: ' + fieldErrors.join(' ') + '</div>'
      : '';
    msg.innerHTML = '<div class="success-msg">Parsed as standard cron (Linux / Kubernetes CronJob syntax).</div>' + warning;
    out.value = CronLib.explainStandardCron(parts);
  } else if (parts.length === 6 || parts.length === 7) {
    msg.innerHTML = '<div class="success-msg">Parsed as Quartz cron (' + parts.length + ' fields, Java/Spring syntax).</div>';
    out.value = CronLib.explainQuartzCron(parts);
  } else {
    msg.innerHTML = '<div class="error-msg">Expected 5 fields (standard cron / Kubernetes CronJob: minute hour day-of-month month day-of-week), or 6-7 fields (Quartz: seconds minute hour day-of-month month day-of-week [year]).</div>';
    out.value = '';
  }
}

function copyShareLink() {
  const url = UrlStateLib.buildShareUrl(location.origin, location.pathname, {
    minute: document.getElementById('minute').value,
    hour: document.getElementById('hour').value,
    dom: document.getElementById('dom').value,
    month: document.getElementById('month').value,
    dow: document.getElementById('dow').value,
    decodeInput: document.getElementById('decodeInput').value,
  });
  const temp = document.createElement('input');
  temp.value = url;
  document.body.appendChild(temp);
  temp.select();
  document.execCommand('copy');
  document.body.removeChild(temp);
  document.getElementById('decodeMsg').innerHTML = '<div class="success-msg">Shareable link copied to clipboard.</div>';
}

const BUILD_FIELD_IDS = ['minute', 'hour', 'dom', 'month', 'dow'];

document.addEventListener('keydown', (e) => {
  if (!ShortcutsLib.isRunShortcut(e)) return;
  e.preventDefault();
  const activeId = document.activeElement && document.activeElement.id;
  if (activeId === 'decodeInput') {
    decodeCron();
  } else if (BUILD_FIELD_IDS.includes(activeId)) {
    buildCron();
  }
});

(function restoreFromUrl() {
  const state = UrlStateLib.decodeState(location.search);
  if (!state) return;
  BUILD_FIELD_IDS.forEach((id) => {
    if (typeof state[id] === 'string') document.getElementById(id).value = state[id];
  });
  if (typeof state.decodeInput === 'string') {
    document.getElementById('decodeInput').value = state.decodeInput;
  }
  if (state.decodeInput) decodeCron();
  else if (BUILD_FIELD_IDS.some((id) => typeof state[id] === 'string')) buildCron();
})();

OutputToolbarLib.init();

refreshRecentSelect();
document.getElementById('decodeRecent').addEventListener('change', (e) => {
  if (!e.target.value) return;
  document.getElementById('decodeInput').value = e.target.value;
  decodeCron();
  e.target.value = '';
});
</script>
</BaseLayout>
