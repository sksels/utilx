---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="UtilX — Free Developer Tools: JSON Formatter, Regex Tester, Cron Builder & More"
  description="Free, fast, browser-based developer tools: JSON formatter/validator, regex tester, cron expression builder, password/UUID generator, base64 encoder, and color converter. No sign-up, nothing leaves your browser."
  canonicalPath="/"
  pwa={true}
  includePopupNav={true}
  includeTileOrder={true}
>
<main>
  <div class="wrap">
    <h1>Free developer tools that run entirely in your browser</h1>
    <p class="lede">No sign-up, no file uploads, no data leaves your device. Format JSON, test regex, build cron expressions, generate passwords, and more — instantly.</p>

    <p class="tile-order-hint">
      Drag a tile by its <span class="tile-drag-handle" aria-hidden="true">&#10022;&#10022;</span> handle to reorder them — your layout is saved in this browser only.
      <button type="button" class="secondary tile-reset-btn" onclick="resetTileLayout()">Reset tile order</button>
    </p>

    <div class="tool-grid">
      <div class="tool-card" data-tool-id="json-formatter" draggable="true">
        <span class="tile-drag-handle" aria-hidden="true" title="Drag to reorder">&#10022;&#10022;</span>
        <a class="tool-card-link" href="/tools/json-formatter.html" onclick="return openToolPopup(event, this.href)">
          <div class="tool-card-header">
            <div class="tool-icon-chip chip-json">
              <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3c-1.5 0-2 1-2 2v3c0 1-.5 2-2 2 1.5 0 2 1 2 2v3c0 1 .5 2 2 2"/><path d="M16 3c1.5 0 2 1 2 2v3c0 1 .5 2 2 2-1.5 0-2 1-2 2v3c0 1-.5 2-2 2"/></svg>
            </div>
            <h3>JSON Formatter &amp; Validator</h3>
          </div>
          <p>Beautify, minify, validate, and diff JSON with clear error locations.</p>
        </a>
        <a class="tool-card-guide" href="/guides/what-is-json.html">Guide: JSON Basics &rarr;</a>
      </div>
      <div class="tool-card" data-tool-id="regex-tester" draggable="true">
        <span class="tile-drag-handle" aria-hidden="true" title="Drag to reorder">&#10022;&#10022;</span>
        <a class="tool-card-link" href="/tools/regex-tester.html" onclick="return openToolPopup(event, this.href)">
          <div class="tool-card-header">
            <div class="tool-icon-chip chip-regex">
              <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6"/><line x1="20" y1="20" x2="14.5" y2="14.5"/><path d="M8 10h1M11 10h1M14 10h.5" stroke-width="1.4"/></svg>
            </div>
            <h3>Regex Tester</h3>
          </div>
          <p>Test patterns with live match highlighting and a plain-English explainer.</p>
        </a>
        <a class="tool-card-guide" href="/guides/regex-cheatsheet.html">Guide: Regex Cheat Sheet &rarr;</a>
      </div>
      <div class="tool-card" data-tool-id="cron-builder" draggable="true">
        <span class="tile-drag-handle" aria-hidden="true" title="Drag to reorder">&#10022;&#10022;</span>
        <a class="tool-card-link" href="/tools/cron-builder.html" onclick="return openToolPopup(event, this.href)">
          <div class="tool-card-header">
            <div class="tool-icon-chip chip-cron">
              <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
            </div>
            <h3>Cron Expression Builder</h3>
          </div>
          <p>Build and decode standard, Quartz, and Kubernetes cron schedules.</p>
        </a>
        <a class="tool-card-guide" href="/guides/cron-syntax-guide.html">Guide: Cron Syntax &rarr;</a>
      </div>
      <div class="tool-card" data-tool-id="password-generator" draggable="true">
        <span class="tile-drag-handle" aria-hidden="true" title="Drag to reorder">&#10022;&#10022;</span>
        <a class="tool-card-link" href="/tools/password-generator.html" onclick="return openToolPopup(event, this.href)">
          <div class="tool-card-header">
            <div class="tool-icon-chip chip-password">
              <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l2.5 2.5M14.5 8.5L17 11"/></svg>
            </div>
            <h3>Password &amp; UUID Generator</h3>
          </div>
          <p>Generate strong passwords and UUID v4 or time-sortable v7 identifiers.</p>
        </a>
      </div>
      <div class="tool-card" data-tool-id="base64-tool" draggable="true">
        <span class="tile-drag-handle" aria-hidden="true" title="Drag to reorder">&#10022;&#10022;</span>
        <a class="tool-card-link" href="/tools/base64-tool.html" onclick="return openToolPopup(event, this.href)">
          <div class="tool-card-header">
            <div class="tool-icon-chip chip-base64">
              <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h11l-3-3M4 7l3 3"/><path d="M20 17H9l3 3M20 17l-3-3"/></svg>
            </div>
            <h3>Base64 Encoder / Decoder</h3>
          </div>
          <p>Encode and decode text or files, plus decode JWTs, to and from Base64.</p>
        </a>
        <a class="tool-card-guide" href="/guides/understanding-base64.html">Guide: Understanding Base64 &rarr;</a>
      </div>
      <div class="tool-card" data-tool-id="color-converter" draggable="true">
        <span class="tile-drag-handle" aria-hidden="true" title="Drag to reorder">&#10022;&#10022;</span>
        <a class="tool-card-link" href="/tools/color-converter.html" onclick="return openToolPopup(event, this.href)">
          <div class="tool-card-header">
            <div class="tool-icon-chip chip-color">
              <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18c1 0 1.5-.5 1.5-1.3 0-.4-.15-.7-.4-1-.25-.3-.4-.6-.4-1 0-.8.7-1.4 1.5-1.4H16a4 4 0 0 0 4-4c0-5-3.6-9-8-9Z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="9.5" cy="7" r="1"/><circle cx="14" cy="7" r="1"/><circle cx="16" cy="10.5" r="1"/></svg>
            </div>
            <h3>Color Converter</h3>
          </div>
          <p>Convert HEX, RGB, and HSL, sample from an image, and check WCAG contrast.</p>
        </a>
      </div>
    </div>
  </div>
</main>

<script slot="body-end" is:inline>
(function () {
  var grid = document.querySelector('.tool-grid');
  // Captured before any reordering happens, so this always reflects the tiles' original
  // markup order -- used by the "Reset tile order" button.
  var defaultIds = Array.prototype.slice.call(grid.children).map(function (c) { return c.dataset.toolId; });
  TileOrderLib.initTileOrder(grid, TileOrderLib.STORAGE_KEY);
  window.resetTileLayout = function () {
    TileOrderLib.resetTileOrder(grid, TileOrderLib.STORAGE_KEY, defaultIds);
  };
})();
</script>
</BaseLayout>
