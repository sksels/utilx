---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact | UtilX"
  description="Get in touch with UtilX to report a bug, suggest a new tool, or ask about advertising."
  canonicalPath="/contact.html"
>
<main>
  <div class="wrap">
    <h1>Contact</h1>
    <p class="lede">Found a bug, have a tool suggestion, or a question about this site? Reach out at the email below.</p>

    <div class="card">
      <p style="margin:0;">Email: <a href="mailto:hello@utilx.tools">hello@utilx.tools</a></p>
    </div>
  </div>
</main>
</BaseLayout>
